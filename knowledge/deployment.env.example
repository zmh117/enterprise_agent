# 复制到宿主机受保护配置文件；本示例没有真实凭据。
# 必须明确指向原知识库卷。首次空部署请手动创建三个卷。
KNOWLEDGE_MODEL_VOLUME=enterprise_agent_knowledge-models
KNOWLEDGE_RERANKER_VOLUME=enterprise_agent_knowledge-reranker-models
KNOWLEDGE_QDRANT_VOLUME=enterprise_agent_knowledge-qdrant
KNOWLEDGE_STATE_VOLUME=enterprise_agent_knowledge_ops_state
KNOWLEDGE_CONTENT_NETWORK=enterprise_agent_knowledge_managed
KNOWLEDGE_CONTROL_NETWORK=enterprise_agent_agent-runtime-control
# 与主平台同一个数据库；不要把真实值写入版本库。
KNOWLEDGE_DATABASE_DSN=
APP_CONFIG_MASTER_KEY_FILE=/etc/enterprise-agent/app-config-master-key
PRINCIPAL_JWKS_FILE=/etc/enterprise-agent/principal-jwks.json
KNOWLEDGE_BOOTSTRAP_TOKEN_FILE=/etc/enterprise-agent/knowledge-bootstrap-token
ONES_MCP_PROVIDER_ALLOWED_HOSTS=ones.example.internal
ONES_MCP_PROVIDER_ALLOW_INSECURE_LOCAL=false
APP_ENV=production
KNOWLEDGE_QDRANT_BIND=127.0.0.1
HF_ENDPOINT=https://huggingface.co
