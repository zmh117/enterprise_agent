# Enterprise Agent 部署环境变量示例
#
# 本文件只保留数据库无法自举的配置、部署安全边界和基础设施参数。
# DB、Redis、Loki 资源只通过 platformctl 与声明式 Manifest 配置；
# 真实密钥不要提交到仓库；请通过仓库外文件或 platformctl secret 注入。

# -----------------------------------------------------------------------------
# 核心自举配置
# -----------------------------------------------------------------------------
# 非 Compose 部署需要显式提供；Compose 会注入容器网络内的固定地址。
# 仅 migrator 使用 owner DSN；运行服务必须使用下面的独立最小权限身份。
DATABASE_DSN=postgresql://enterprise_agent:enterprise_agent@postgres:5432/enterprise_agent
API_DATABASE_DSN=postgresql://enterprise_agent_api:replace-me@postgres:5432/enterprise_agent
WORKER_DATABASE_DSN=postgresql://enterprise_agent_worker:replace-me@postgres:5432/enterprise_agent
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
APP_ENV=local
# 仅用于首次初始化本地默认数据，已有环境通常保持 false。
SEED_LOCAL_CONFIG=false

# 仓库外固定 Master Key 文件，用于解密数据库中的受管凭据。
# 文件格式和生成方式见 docs/platform-master-key.md。
APP_CONFIG_MASTER_KEY_FILE=/absolute/path/to/app-config-master-key

# -----------------------------------------------------------------------------
# 服务间认证密钥
# -----------------------------------------------------------------------------
# Agent Worker 与两个自托管 MCP Server 共享的短期令牌签名密钥。
# 文件至少包含 32 个随机字节，只读挂载，不得与 ONES/数据库凭据复用。
MCP_TOKEN_SIGNING_KEY_FILE=/absolute/path/to/mcp-token-signing-key
# 钉钉 Runtime 与控制面的内部认证 Token，应使用高强度随机值。
DINGTALK_RUNTIME_AUTH_TOKEN=replace-with-a-long-random-token

# 生产环境应为 MCP Server 配置独立、只读的 PostgreSQL 角色与 DSN。
ONES_MCP_DATABASE_DSN=postgresql://ones_mcp_reader:replace-me@postgres:5432/enterprise_agent
DATA_MCP_DATABASE_DSN=postgresql://data_mcp_runtime:replace-me@postgres:5432/enterprise_agent
# migrator 只在创建/更新固定服务角色时读取这些值；不得写入镜像或日志。
API_DATABASE_PASSWORD=replace-me
WORKER_DATABASE_PASSWORD=replace-me
ONES_MCP_DATABASE_PASSWORD=replace-me
DATA_MCP_DATABASE_PASSWORD=replace-me

# -----------------------------------------------------------------------------
# Compose 基础设施
# -----------------------------------------------------------------------------
# 生产环境应改为已验证的完整补丁标签或镜像摘要，避免直接使用浮动标签。
POSTGRES_IMAGE=postgres:18
RABBITMQ_IMAGE=rabbitmq:4-management
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
ADMIN_WEB_PORT=8080
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

# -----------------------------------------------------------------------------
# 顶层部署安全开关
# -----------------------------------------------------------------------------
# 这些开关只能由部署环境控制，不能通过数据库运行配置开启。
FEATURE_WEB_ADMIN=false
FEATURE_PUBLISHED_AGENT_RUNTIME=false
FEATURE_REAL_CLAUDE=false

# 仅维护窗口临时开启；正常运行必须保持 false。
DESTRUCTIVE_CUTOVER_ENABLED=false

# -----------------------------------------------------------------------------
# Web 管理端与外部身份
# -----------------------------------------------------------------------------
# 本地 HTTP 开发使用 false；HTTPS 生产环境必须使用 true。
WEB_COOKIE_SECURE=false
# 跨域部署时填写逗号分隔的精确 Origin；同源部署可留空。
WEB_ALLOWED_ORIGINS=

# ONES 登录按需启用；生产环境必须使用 HTTPS，并限制为精确主机名。
ONES_IDENTITY_BASE_URL=
ONES_IDENTITY_ALLOWED_HOSTS=
ONES_IDENTITY_ALLOW_INSECURE_LOCAL=false

# -----------------------------------------------------------------------------
# 附件对象存储
# -----------------------------------------------------------------------------
# 默认连接 Compose 内的 MinIO；使用外部 S3 兼容存储时覆盖这些值。
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=enterprise_agent
S3_SECRET_KEY=replace-with-a-strong-object-storage-secret
S3_BUCKET=agent-attachments
S3_REGION=us-east-1
S3_SECURE=false

# -----------------------------------------------------------------------------
# 模型连接安全边界
# -----------------------------------------------------------------------------
# 模型地址、模型名和 API Key 在管理端配置；这里只允许部署侧收紧主机白名单。
MODEL_PROVIDER_HOST_ALLOWLIST=api.deepseek.com
