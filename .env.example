# Enterprise Agent 部署环境变量示例
#
# 本文件只保留数据库无法自举的配置、部署安全边界和基础设施参数。
# DB、Redis、Loki 资源请在“平台治理 -> 工具资源”中配置；
# 模型连接、钉钉机器人、业务路由和运行参数请在管理端配置并存入 PostgreSQL。
# 真实密钥不要提交到仓库；请通过仓库外文件或管理端凭据中心注入。

# -----------------------------------------------------------------------------
# 核心自举配置
# -----------------------------------------------------------------------------
# 非 Compose 部署需要显式提供；Compose 会注入容器网络内的固定地址。
DATABASE_DSN=postgresql://enterprise_agent:enterprise_agent@postgres:5432/enterprise_agent
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
APP_ENV=local
# 仅用于首次初始化本地默认数据，已有环境通常保持 false。
SEED_LOCAL_CONFIG=false
# staging/production 初始管理员只接受受限权限的密码文件；local/test 文件缺失时
# 使用文档化的本地初始密码，首次登录后必须修改。
INITIAL_ADMIN_PASSWORD_FILE=/run/secrets/initial_admin_password

# 仓库外固定 Master Key 文件，用于解密数据库中的受管凭据。
# 文件格式和生成方式见 docs/operations/platform-master-key.md。
APP_CONFIG_MASTER_KEY_FILE=/absolute/path/to/app-config-master-key

# -----------------------------------------------------------------------------
# 服务间认证
# -----------------------------------------------------------------------------
# 钉钉 Runtime 与控制面的内部认证 Token，应使用高强度随机值。
DINGTALK_RUNTIME_AUTH_TOKEN=replace-with-a-long-random-token

# Python 与 TypeScript Agent Runtime 服务身份。先运行
# `scripts/bootstrap_agent_runtime_secrets.sh /absolute/secret/directory`，再填写生成文件。
RUNTIME_GRANT_PRIVATE_KEY_FILE=/absolute/path/to/runtime-grant-private.pem
RUNTIME_GRANT_PUBLIC_KEY_FILE=/absolute/path/to/runtime-grant-public.pem
MODEL_PROBE_AUTH_TOKEN_FILE=/absolute/path/to/model-probe-auth-token
# 平台只维护这一套 Principal Ed25519 信任根：API 与 agent-worker 仅在
# 签发对应 Token 时挂载私钥，File Service、ONES MCP 及后续 MCP 只挂载 JWKS。
PRINCIPAL_JWT_PRIVATE_KEY_FILE=/absolute/path/to/principal-jwt-private.pem
PRINCIPAL_JWKS_FILE=/absolute/path/to/principal-jwks.json
PRINCIPAL_JWT_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Compose 基础设施
# -----------------------------------------------------------------------------
# 生产环境应改为已验证的完整补丁标签或镜像摘要，避免直接使用浮动标签。
POSTGRES_IMAGE=postgres:18
# 仅当复用一个没有Compose标签的既有同名数据卷时设为true；全新环境保持false。
POSTGRES18_VOLUME_EXTERNAL=false
RABBITMQ_IMAGE=rabbitmq:4-management
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
ADMIN_WEB_PORT=8080
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

# Agent Runtime 使用独立最小权限数据库角色。生产环境必须替换本地示例密码，
# 且 AGENT_RUNTIME_DATABASE_DSN 中的密码应与迁移器使用的密码一致。
AGENT_RUNTIME_DATABASE_PASSWORD=replace-with-a-long-random-database-password
AGENT_RUNTIME_DATABASE_DSN=postgresql://agent_runtime_reader:replace-with-a-long-random-database-password@postgres:5432/enterprise_agent

# -----------------------------------------------------------------------------
# 顶层部署安全开关
# -----------------------------------------------------------------------------
# 这三项只能由部署环境控制，不能通过数据库运行配置开启。
FEATURE_WEB_ADMIN=false
FEATURE_PUBLISHED_AGENT_RUNTIME=false
FEATURE_REAL_CLAUDE=false

# Runtime 日志与 ledger 生命周期是部署参数；Job 的 Runtime 只由 Agent Publication 固定。
AGENT_RUNTIME_LOG_LEVEL=info
AGENT_RUNTIME_LEDGER_TTL_SECONDS=3600
# 仅供 APP_ENV=test/testing 的隔离 Compose 验收；生产和普通本地运行必须保持 disabled。
AGENT_RUNTIME_TEST_PROVIDER_MODE=disabled

# -----------------------------------------------------------------------------
# Web 管理端与外部身份
# -----------------------------------------------------------------------------
# 本地 HTTP 开发使用 false；HTTPS 生产环境必须使用 true。
WEB_COOKIE_SECURE=false
# 跨域部署时填写逗号分隔的精确 Origin；同源部署可留空。
WEB_ALLOWED_ORIGINS=

# ONES 本人绑定会保存加密登录材料与当前 Token；公开 API 仅显示凭据状态。
# Base URL 必须是受信实例根地址；登录 Path 由代码固定。
ONES_IDENTITY_INSTANCE_CODE=default
ONES_IDENTITY_DISPLAY_NAME=ONES
# 本地独立 ones-mock 发布到宿主机 19121；生产必须覆盖为受信 HTTPS Provider。
ONES_IDENTITY_BASE_URL=http://host.docker.internal:19121
ONES_IDENTITY_ALLOWED_HOSTS=host.docker.internal
ONES_IDENTITY_TIMEOUT_SECONDS=5
ONES_IDENTITY_MAX_RESPONSE_BYTES=65536
# 只允许 local/test 使用 HTTP Mock；APP_ENV=production 会拒绝 HTTP Provider。
ONES_IDENTITY_ALLOW_INSECURE_LOCAL=true
ONES_IDENTITY_CHALLENGE_TTL_SECONDS=600

# ones-mcp 使用独立固定 Provider 边界；URL、Header 和 GraphQL document
# 均不能由 Agent 或 Tool Input 覆盖。生产必须使用 HTTPS allowlist。
ONES_MCP_PROVIDER_BASE_URL=http://host.docker.internal:19121
ONES_MCP_PROVIDER_ALLOWED_HOSTS=host.docker.internal
ONES_MCP_PROVIDER_TIMEOUT_SECONDS=5
ONES_MCP_PROVIDER_MAX_RESPONSE_BYTES=262144
ONES_MCP_MAX_REQUEST_BYTES=32768
# 仅 local/test 的仓库 Mock 可设为 true；APP_ENV=production 会拒绝 HTTP Provider。
ONES_MCP_PROVIDER_ALLOW_INSECURE_LOCAL=true
# 必填且范围为 1..3650；缺失或非法时 ones-mcp readiness 失败。
MCP_OPERATION_AUDIT_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# MinIO 基础设施与受治理 File Service
# -----------------------------------------------------------------------------
# MINIO_ROOT_* 只启动 Compose 内的 MinIO/minio-init，不是应用对象存储配置，
# 也不注入 Agent、Runtime、File Worker 或 Delivery Worker。以下本地默认值
# 只允许 APP_ENV=local/test/testing/development；非本地部署必须替换。
MINIO_ROOT_USER=enterprise_agent
MINIO_ROOT_PASSWORD=replace-with-a-strong-object-storage-secret
# File Service 是唯一对象存储访问边界；应用侧只配置 endpoint、私有 Bucket
# 和平台 Secret Reference，不再提供应用侧对象存储直连配置。
FILE_STORAGE_ENDPOINT_URL=http://minio:9000
FILE_STORAGE_BUCKET=agent-files
FILE_STORAGE_LEGACY_ATTACHMENT_BUCKET=agent-attachments
FILE_STORAGE_ACCESS_KEY_REF=secret://platform/minio-file-access-key
FILE_STORAGE_SECRET_KEY_REF=secret://platform/minio-file-secret-key
FILE_STORAGE_REGION=us-east-1
FILE_STORAGE_SECURE=false
# 仅本地 Compose 首次启动使用：Migrator 把 MINIO_ROOT_* 写入受治理的
# encrypted_db Secret；已存在但值不同会失败，必须通过显式轮换处理。
FILE_STORAGE_SECRET_BOOTSTRAP_ENABLED=true

# 平台身份服务复用统一 Principal Ed25519 私钥签发不超过 300 秒的服务 JWT；
# 用户/Job 与服务 JWT 共享 PRINCIPAL_JWKS，但使用独立 claim 验证策略。
# Worker 只挂载各自的 bootstrap 凭据，按需换取并自动刷新短时 JWT；
# bootstrap 凭据不能互换，也不是 File Service 或 MinIO 的直接访问凭据。
FILE_WORKER_BOOTSTRAP_TOKEN_FILE=${HOME}/.config/enterprise-agent/file-worker-bootstrap-token
FILE_PROCESSING_WORKER_BOOTSTRAP_TOKEN_FILE=${HOME}/.config/enterprise-agent/file-processing-worker-bootstrap-token
DELIVERY_WORKER_BOOTSTRAP_TOKEN_FILE=${HOME}/.config/enterprise-agent/delivery-worker-bootstrap-token
DOCLING_SERVE_API_KEY_FILE=${HOME}/.config/enterprise-agent/docling-api-key
SERVICE_PRINCIPAL_TTL_SECONDS=300
SERVICE_PRINCIPAL_REFRESH_SKEW_SECONDS=60
SERVICE_IDENTITY_TIMEOUT_SECONDS=5

# 文档处理只走固定内部 Docling Serve；Compose 固定 v1.30.0 multi-arch digest，
# 不发布宿主端口，也不允许 URL source、远程服务、插件或运行时模型下载。
DOCLING_SERVE_INTERNAL_BASE_URL=http://docling-serve:5001
DOCLING_SERVE_INTERNAL_ALLOWED_HOSTS=docling-serve
DOCLING_SERVE_CONNECT_TIMEOUT_SECONDS=5
DOCLING_SERVE_POLL_INTERVAL_SECONDS=2
DOCLING_SERVE_TOTAL_TIMEOUT_SECONDS=600
DOCLING_SERVE_MAX_RESPONSE_BYTES=83886080
FILE_PROCESSING_WORKER_CONCURRENCY=1
FILE_PROCESSING_MAX_ATTEMPTS=3
FILE_PROCESSING_RETRY_BASE_SECONDS=30

# Runtime 容器 tmpfs 为 256 MiB；每 Job 受治理工作集为 224 MiB，保留
# 32 MiB 安全余量。readiness 要求实际可用空间至少 64 MiB。
AGENT_RUNTIME_TMPFS_SIZE=256m
AGENT_RUNTIME_SANDBOX_CAPACITY_BYTES=234881024
AGENT_RUNTIME_SANDBOX_MAX_FILES=40
AGENT_RUNTIME_SANDBOX_MAX_FILE_BYTES=15728640
AGENT_RUNTIME_SANDBOX_CLEANUP_INTERVAL_SECONDS=300

# -----------------------------------------------------------------------------
# 模型连接安全边界
# -----------------------------------------------------------------------------
# 模型地址、模型名和 API Key 在管理端配置；这里只允许部署侧收紧主机白名单。
MODEL_PROVIDER_HOST_ALLOWLIST=api.deepseek.com
