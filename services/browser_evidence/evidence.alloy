loki.source.api "browser" {
  http {
    listen_address = "0.0.0.0"
    listen_port = 3500
  }
  grpc {
    listen_address = "127.0.0.1"
  }
  use_incoming_timestamp = true
  max_send_message_size = "1MiB"
  forward_to = [loki.process.browser.receiver]
}

loki.process "browser" {
  stage.tenant {
    label = "evidence_tenant"
  }
  stage.label_drop {
    values = ["evidence_tenant"]
  }
  forward_to = [loki.write.browser.receiver]
}

loki.write "browser" {
  endpoint {
    url = "http://evidence-loki:3100/loki/api/v1/push"
    batch_wait = "250ms"
  }
}
