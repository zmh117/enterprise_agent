{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-agent.internal/contracts/agent-runtime/v1.4/protocol.schema.json",
  "title": "Enterprise Agent Runtime Protocol V1.4",
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "RuntimeKind": {
      "const": "python-v1"
    },
    "BuildIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "source_revision",
        "build_id",
        "platform"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/Identifier"
        },
        "source_revision": {
          "$ref": "#/$defs/Identifier"
        },
        "build_id": {
          "$ref": "#/$defs/Identifier"
        },
        "platform": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-z0-9._-]+/[a-z0-9._-]+$"
        },
        "image_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "SafeMessage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "JsonSummary": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null"
        ]
      }
    },
    "ExecutionLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds",
        "max_turns",
        "max_tool_calls"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        }
      }
    },
    "Prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_version",
        "system_role",
        "safety_rules",
        "business_instructions",
        "tool_restrictions",
        "user_question",
        "conversation_summary",
        "retrieved_context"
      ],
      "properties": {
        "template_version": {
          "$ref": "#/$defs/Identifier"
        },
        "system_role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "safety_rules": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "business_instructions": {
          "type": "string",
          "maxLength": 32768
        },
        "tool_restrictions": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "user_question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 131072
        },
        "conversation_summary": {
          "type": "string",
          "maxLength": 32768
        },
        "retrieved_context": {
          "type": "object",
          "maxProperties": 128
        },
        "skills": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "type": "string",
            "maxLength": 32768
          }
        },
        "mcp_unavailable_notices": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool_name",
              "reason_code",
              "message"
            ],
            "properties": {
              "tool_name": {
                "$ref": "#/$defs/Identifier"
              },
              "reason_code": {
                "$ref": "#/$defs/Identifier"
              },
              "message": {
                "$ref": "#/$defs/SafeMessage"
              }
            }
          }
        }
      }
    },
    "ModelConnectionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_id",
        "config_hash"
      ],
      "properties": {
        "revision_id": {
          "$ref": "#/$defs/Identifier"
        },
        "config_hash": {
          "$ref": "#/$defs/Sha256Digest"
        }
      }
    },
    "ModelProbeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "runtime_kind",
        "probe_id",
        "model_connection",
        "timeout_seconds"
      ],
      "properties": {
        "protocol_version": {
          "const": "1.4"
        },
        "runtime_kind": {
          "$ref": "#/$defs/RuntimeKind"
        },
        "probe_id": {
          "$ref": "#/$defs/Identifier"
        },
        "model_connection": {
          "$ref": "#/$defs/ModelConnectionBinding"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 3,
          "maximum": 20
        }
      }
    },
    "ModelProbeCredentialEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "nonce",
        "ciphertext",
        "expires_at"
      ],
      "properties": {
        "algorithm": {
          "const": "AES-256-GCM-DERIVED-PROBE-V1"
        },
        "nonce": {
          "type": "string",
          "minLength": 16,
          "maxLength": 16,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "ciphertext": {
          "type": "string",
          "minLength": 24,
          "maxLength": 16384,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "expires_at": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "DraftModelProbeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "runtime_kind",
        "probe_id",
        "config_hash",
        "credential_envelope",
        "timeout_seconds"
      ],
      "properties": {
        "protocol_version": {
          "const": "1.4"
        },
        "runtime_kind": {
          "$ref": "#/$defs/RuntimeKind"
        },
        "probe_id": {
          "$ref": "#/$defs/Identifier"
        },
        "config_hash": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "credential_envelope": {
          "$ref": "#/$defs/ModelProbeCredentialEnvelope"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 3,
          "maximum": 20
        }
      }
    },
    "ModelProbeFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "safe_message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/Identifier"
        },
        "safe_message": {
          "$ref": "#/$defs/SafeMessage"
        }
      }
    },
    "ModelProbeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "runtime_kind",
        "probe_id",
        "success",
        "connection_revision_id",
        "provider_host",
        "model",
        "runtime_version",
        "sdk_version",
        "duration_ms"
      ],
      "properties": {
        "protocol_version": {
          "const": "1.4"
        },
        "runtime_kind": {
          "$ref": "#/$defs/RuntimeKind"
        },
        "probe_id": {
          "$ref": "#/$defs/Identifier"
        },
        "success": {
          "type": "boolean"
        },
        "connection_revision_id": {
          "$ref": "#/$defs/Identifier"
        },
        "provider_host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "runtime_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sdk_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        },
        "failure": {
          "$ref": "#/$defs/ModelProbeFailure"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "success": {
                "const": false
              }
            }
          },
          "then": {
            "required": [
              "failure"
            ],
            "properties": {
              "failure": {
                "$ref": "#/$defs/ModelProbeFailure"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "success": {
                "const": true
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "failure"
              ],
              "properties": {
                "failure": {}
              }
            }
          }
        }
      ]
    },
    "McpToolBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_name",
        "required_scope",
        "tool_schema_hash"
      ],
      "properties": {
        "tool_name": {
          "$ref": "#/$defs/Identifier"
        },
        "required_scope": {
          "$ref": "#/$defs/Identifier"
        },
        "tool_schema_hash": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "resource_code": {
          "$ref": "#/$defs/Identifier"
        },
        "resource_deployment_id": {
          "$ref": "#/$defs/Identifier"
        },
        "resource_revision_id": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "McpServerBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server_code",
        "tools"
      ],
      "properties": {
        "server_code": {
          "$ref": "#/$defs/Identifier"
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/McpToolBinding"
          }
        }
      }
    },
    "AgentExecutionRequestV14": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "runtime_kind",
        "invocation_id",
        "request_digest",
        "job_id",
        "app_user_id",
        "project_code",
        "agent_publication_id",
        "application_publication_id",
        "job_tool_snapshot_hash",
        "control_plane_build_identity",
        "worker_build_identity",
        "model_connection",
        "prompt",
        "limits",
        "mcp_servers",
        "file_context"
      ],
      "properties": {
        "protocol_version": {
          "const": "1.4"
        },
        "runtime_kind": {
          "$ref": "#/$defs/RuntimeKind"
        },
        "invocation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "request_digest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "job_id": {
          "$ref": "#/$defs/Identifier"
        },
        "app_user_id": {
          "$ref": "#/$defs/Identifier"
        },
        "project_code": {
          "$ref": "#/$defs/Identifier"
        },
        "agent_publication_id": {
          "$ref": "#/$defs/Identifier"
        },
        "application_publication_id": {
          "$ref": "#/$defs/Identifier"
        },
        "job_tool_snapshot_hash": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "control_plane_build_identity": {
          "$ref": "#/$defs/BuildIdentity"
        },
        "worker_build_identity": {
          "$ref": "#/$defs/BuildIdentity"
        },
        "model_connection": {
          "$ref": "#/$defs/ModelConnectionBinding"
        },
        "prompt": {
          "$ref": "#/$defs/Prompt"
        },
        "limits": {
          "$ref": "#/$defs/ExecutionLimits"
        },
        "mcp_servers": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/McpServerBinding"
          }
        },
        "file_context": {
          "$ref": "#/$defs/FileContext"
        }
      }
    },
    "RuntimeGrantClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iss",
        "aud",
        "azp",
        "runtime_kind",
        "sub",
        "job_id",
        "invocation_id",
        "agent_publication_id",
        "application_publication_id",
        "request_digest",
        "iat",
        "nbf",
        "exp",
        "jti"
      ],
      "properties": {
        "iss": {
          "const": "enterprise-agent-worker"
        },
        "aud": {
          "const": "agent-runtime"
        },
        "azp": {
          "const": "agent-worker"
        },
        "runtime_kind": {
          "$ref": "#/$defs/RuntimeKind"
        },
        "sub": {
          "$ref": "#/$defs/Identifier"
        },
        "job_id": {
          "$ref": "#/$defs/Identifier"
        },
        "invocation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "agent_publication_id": {
          "$ref": "#/$defs/Identifier"
        },
        "application_publication_id": {
          "$ref": "#/$defs/Identifier"
        },
        "request_digest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "iat": {
          "type": "integer",
          "minimum": 1
        },
        "nbf": {
          "type": "integer",
          "minimum": 1
        },
        "exp": {
          "type": "integer",
          "minimum": 1
        },
        "jti": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "Usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_input_tokens",
        "cache_creation_input_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_read_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_creation_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "McpConnectionStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server_code",
        "status"
      ],
      "properties": {
        "server_code": {
          "$ref": "#/$defs/Identifier"
        },
        "status": {
          "enum": [
            "CONNECTED",
            "FAILED",
            "DISCONNECTED",
            "UNKNOWN"
          ]
        }
      }
    },
    "RuntimeInitialization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "mcp_servers"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "mcp_servers": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/McpConnectionStatus"
          }
        }
      }
    },
    "ModelCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_call_id",
        "provider_request_id",
        "provider_message_id",
        "model_id",
        "status",
        "started_at",
        "completed_at",
        "duration_ms",
        "duration_source",
        "usage",
        "stop_reason",
        "error_code",
        "error_summary"
      ],
      "properties": {
        "model_call_id": {
          "$ref": "#/$defs/Identifier"
        },
        "provider_request_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "provider_message_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "enum": [
            "SUCCEEDED",
            "FAILED"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1800000
        },
        "duration_source": {
          "enum": [
            "SDK_OBSERVED",
            "UNAVAILABLE"
          ]
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "stop_reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "error_summary": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "duration_source": {
                "const": "UNAVAILABLE"
              }
            }
          },
          "then": {
            "properties": {
              "started_at": {
                "const": null
              },
              "duration_ms": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "ApiRetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "max_retries",
        "retry_delay_ms",
        "error_status",
        "error_code"
      ],
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max_retries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "retry_delay_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1800000
        },
        "error_status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
        },
        "error_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "ModelUsageEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "canonical_model",
        "provider",
        "usage",
        "estimated_cost_usd"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "canonical_model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "provider": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "estimated_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "ExecutionAccounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "duration_ms",
        "duration_api_ms",
        "num_turns",
        "usage",
        "model_usage",
        "estimated_cost_usd",
        "permission_denials_count"
      ],
      "properties": {
        "status": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNAVAILABLE"
          ]
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1800000
        },
        "duration_api_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1800000
        },
        "num_turns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10000
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "model_usage": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/ModelUsageEntry"
          }
        },
        "estimated_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000
        },
        "permission_denials_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        }
      }
    },
    "RuntimeProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_kind",
        "runtime_version",
        "protocol_version",
        "sdk_version",
        "cli_version",
        "runtime_build_identity",
        "model_connection_revision_id",
        "model_connection_config_hash"
      ],
      "properties": {
        "runtime_kind": {
          "$ref": "#/$defs/RuntimeKind"
        },
        "runtime_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "protocol_version": {
          "const": "1.4"
        },
        "sdk_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "cli_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "runtime_build_identity": {
          "$ref": "#/$defs/BuildIdentity"
        },
        "model_connection_revision_id": {
          "$ref": "#/$defs/Identifier"
        },
        "model_connection_config_hash": {
          "$ref": "#/$defs/Sha256Digest"
        }
      }
    },
    "RuntimeFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "retry_class",
        "safe_message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/Identifier"
        },
        "retry_class": {
          "enum": [
            "NEVER",
            "TRANSIENT",
            "CONFIGURATION"
          ]
        },
        "safe_message": {
          "$ref": "#/$defs/SafeMessage"
        }
      }
    },
    "ToolEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_call_id",
        "tool_origin",
        "server_code",
        "mcp_call_id",
        "persisted_tool_call_id",
        "tool_name",
        "status",
        "request_summary",
        "response_summary",
        "duration_ms"
      ],
      "properties": {
        "tool_call_id": {
          "$ref": "#/$defs/Identifier"
        },
        "tool_origin": {
          "enum": [
            "mcp",
            "sdk_builtin",
            "sdk_custom",
            "unknown"
          ]
        },
        "server_code": {
          "oneOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "mcp_call_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "persisted_tool_call_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_name": {
          "$ref": "#/$defs/Identifier"
        },
        "status": {
          "enum": [
            "STARTED",
            "SUCCEEDED",
            "FAILED",
            "DENIED"
          ]
        },
        "request_summary": {
          "$ref": "#/$defs/JsonSummary"
        },
        "response_summary": {
          "$ref": "#/$defs/JsonSummary"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1800000
        },
        "failure": {
          "$ref": "#/$defs/RuntimeFailure"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tool_origin": {
                "const": "mcp"
              }
            }
          },
          "then": {
            "properties": {
              "server_code": {
                "$ref": "#/$defs/Identifier"
              }
            }
          },
          "else": {
            "properties": {
              "server_code": {
                "const": null
              },
              "mcp_call_id": {
                "const": null
              },
              "persisted_tool_call_id": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "TerminalResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "invocation_id",
        "request_digest",
        "last_sequence",
        "status",
        "usage",
        "accounting",
        "runtime_provenance"
      ],
      "properties": {
        "protocol_version": {
          "const": "1.4"
        },
        "invocation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "request_digest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "last_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "status": {
          "enum": [
            "SUCCEEDED",
            "FAILED",
            "CANCELLED"
          ]
        },
        "final_answer": {
          "type": "string",
          "maxLength": 524288
        },
        "failure": {
          "$ref": "#/$defs/RuntimeFailure"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "accounting": {
          "$ref": "#/$defs/ExecutionAccounting"
        },
        "runtime_provenance": {
          "$ref": "#/$defs/RuntimeProvenance"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "SUCCEEDED"
              }
            }
          },
          "then": {
            "required": [
              "final_answer"
            ],
            "properties": {
              "final_answer": {
                "type": "string"
              }
            },
            "not": {
              "required": [
                "failure"
              ],
              "properties": {
                "failure": {}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "FAILED",
                  "CANCELLED"
                ]
              }
            }
          },
          "then": {
            "required": [
              "failure"
            ],
            "properties": {
              "failure": {
                "$ref": "#/$defs/RuntimeFailure"
              }
            }
          }
        }
      ]
    },
