          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "materialization_size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "representation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "representation_kind": {
          "$ref": "#/$defs/RepresentationKind"
        },
        "representation_size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "representation_sha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "representation_format_code": {
          "$ref": "#/$defs/RepresentationKind"
        },
