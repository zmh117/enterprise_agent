{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "RecoverRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocation_id",
        "request_digest"
      ],
      "properties": {
        "invocation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "request_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "InstanceHeaders": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "instance_id"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "instance_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        }
      }
    },
    "PoolControlError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "enum": [
            "runtime_pool_busy",
            "runtime_pool_unavailable",
            "runtime_instance_mismatch",
            "runtime_invocation_owner_mismatch",
            "runtime_request_digest_mismatch",
            "runtime_recovery_expired",
            "runtime_execution_lease_lost",
            "runtime_cancel_intent_missing",
            "runtime_request_invalid",
            "runtime_invocation_not_found",
            "runtime_cancel_requested",
            "runtime_admission_timeout",
            "runtime_invocation_outcome_unknown"
          ]
        }
      }
    },
    "PoolNodeState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "instance_id",
        "pool_enabled",
        "busy",
        "draining"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "instance_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "pool_enabled": {
          "const": true
        },
        "busy": {
          "type": "boolean"
        },
        "draining": {
          "type": "boolean"
        }
      }
    }
  }
}
