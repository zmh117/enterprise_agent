{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-agent.internal/contracts/agent-runtime/v1.1/protocol.schema.json",
  "title": "Enterprise Agent Runtime Protocol V1.1",
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "RuntimeKind": {
      "enum": ["python-v1", "typescript-v1"]
    },
    "SafeMessage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "JsonSummary": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean", "null"]
      }
    },
    "ExecutionLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "max_turns", "max_tool_calls"],
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 1800},
        "max_turns": {"type": "integer", "minimum": 1, "maximum": 100},
        "max_tool_calls": {"type": "integer", "minimum": 0, "maximum": 128}
      }
    },
    "Prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_role",
        "safety_rules",
        "business_instructions",
        "tool_restrictions",
        "user_question",
        "conversation_summary",
        "retrieved_context"
      ],
      "properties": {
        "system_role": {"type": "string", "minLength": 1, "maxLength": 16384},
        "safety_rules": {
          "type": "array",
          "maxItems": 128,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "business_instructions": {"type": "string", "maxLength": 32768},
        "tool_restrictions": {
          "type": "array",
          "maxItems": 128,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "user_question": {"type": "string", "minLength": 1, "maxLength": 131072},
        "conversation_summary": {"type": "string", "maxLength": 32768},
        "retrieved_context": {"type": "object", "maxProperties": 128},
        "skills": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {"type": "string", "maxLength": 32768}
        },
        "mcp_unavailable_notices": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tool_name", "reason_code", "message"],
            "properties": {
              "tool_name": {"$ref": "#/$defs/Identifier"},
              "reason_code": {"$ref": "#/$defs/Identifier"},
              "message": {"$ref": "#/$defs/SafeMessage"}
            }
          }
        }
      }
    },
    "ModelConnectionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision_id", "config_hash"],
      "properties": {
        "revision_id": {"$ref": "#/$defs/Identifier"},
        "config_hash": {"$ref": "#/$defs/Sha256Digest"}
      }
    },
    "ModelProbeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "runtime_kind", "probe_id", "model_connection", "timeout_seconds"],
      "properties": {
        "protocol_version": {"const": "1.1"},
        "runtime_kind": {"$ref": "#/$defs/RuntimeKind"},
        "probe_id": {"$ref": "#/$defs/Identifier"},
        "model_connection": {"$ref": "#/$defs/ModelConnectionBinding"},
        "timeout_seconds": {"type": "integer", "minimum": 3, "maximum": 20}
      }
    },
    "ModelProbeCredentialEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "nonce", "ciphertext", "expires_at"],
      "properties": {
        "algorithm": {"const": "AES-256-GCM-DERIVED-PROBE-V1"},
        "nonce": {
          "type": "string",
          "minLength": 16,
          "maxLength": 16,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "ciphertext": {
          "type": "string",
          "minLength": 24,
          "maxLength": 16384,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "expires_at": {"type": "integer", "minimum": 1}
      }
    },
    "DraftModelProbeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "runtime_kind",
        "probe_id",
        "config_hash",
        "credential_envelope",
        "timeout_seconds"
      ],
      "properties": {
        "protocol_version": {"const": "1.1"},
        "runtime_kind": {"$ref": "#/$defs/RuntimeKind"},
        "probe_id": {"$ref": "#/$defs/Identifier"},
        "config_hash": {"$ref": "#/$defs/Sha256Digest"},
        "credential_envelope": {"$ref": "#/$defs/ModelProbeCredentialEnvelope"},
        "timeout_seconds": {"type": "integer", "minimum": 3, "maximum": 20}
      }
    },
    "ModelProbeFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "safe_message"],
      "properties": {
        "code": {"$ref": "#/$defs/Identifier"},
        "safe_message": {"$ref": "#/$defs/SafeMessage"}
      }
    },
    "ModelProbeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "runtime_kind",
        "probe_id",
        "success",
        "connection_revision_id",
        "provider_host",
        "model",
        "runtime_version",
        "sdk_version",
        "duration_ms"
      ],
      "properties": {
        "protocol_version": {"const": "1.1"},
        "runtime_kind": {"$ref": "#/$defs/RuntimeKind"},
        "probe_id": {"$ref": "#/$defs/Identifier"},
        "success": {"type": "boolean"},
        "connection_revision_id": {"$ref": "#/$defs/Identifier"},
        "provider_host": {"type": "string", "minLength": 1, "maxLength": 253},
        "model": {"type": "string", "minLength": 1, "maxLength": 200},
        "runtime_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sdk_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "duration_ms": {"type": "integer", "minimum": 0, "maximum": 30000},
        "failure": {"$ref": "#/$defs/ModelProbeFailure"}
      },
      "allOf": [
        {
          "if": {"properties": {"success": {"const": false}}},
          "then": {
            "required": ["failure"],
            "properties": {"failure": {"$ref": "#/$defs/ModelProbeFailure"}}
          }
        },
        {
          "if": {"properties": {"success": {"const": true}}},
          "then": {
            "not": {
              "required": ["failure"],
              "properties": {"failure": {}}
            }
          }
        }
      ]
    },
    "McpToolBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_name", "required_scope", "tool_schema_hash"],
      "properties": {
        "tool_name": {"$ref": "#/$defs/Identifier"},
        "required_scope": {"$ref": "#/$defs/Identifier"},
        "tool_schema_hash": {"$ref": "#/$defs/Sha256Digest"},
        "resource_code": {"$ref": "#/$defs/Identifier"},
        "resource_deployment_id": {"$ref": "#/$defs/Identifier"},
        "resource_revision_id": {"$ref": "#/$defs/Identifier"}
      }
    },
    "McpServerBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server_code", "tools"],
      "properties": {
        "server_code": {"$ref": "#/$defs/Identifier"},
        "tools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {"$ref": "#/$defs/McpToolBinding"}
        }
      }
    },
    "AgentExecutionRequestV11": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "runtime_kind",
        "invocation_id",
        "request_digest",
        "job_id",
        "app_user_id",
        "project_code",
        "agent_publication_id",
        "application_publication_id",
        "model_connection",
        "prompt",
        "limits",
        "mcp_servers"
      ],
      "properties": {
        "protocol_version": {"const": "1.1"},
        "runtime_kind": {"$ref": "#/$defs/RuntimeKind"},
        "invocation_id": {"$ref": "#/$defs/Identifier"},
        "request_digest": {"$ref": "#/$defs/Sha256Digest"},
        "job_id": {"$ref": "#/$defs/Identifier"},
        "app_user_id": {"$ref": "#/$defs/Identifier"},
        "project_code": {"$ref": "#/$defs/Identifier"},
        "agent_publication_id": {"$ref": "#/$defs/Identifier"},
        "application_publication_id": {"$ref": "#/$defs/Identifier"},
        "model_connection": {"$ref": "#/$defs/ModelConnectionBinding"},
        "prompt": {"$ref": "#/$defs/Prompt"},
        "limits": {"$ref": "#/$defs/ExecutionLimits"},
        "mcp_servers": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/McpServerBinding"}
        }
      }
    },
    "RuntimeGrantClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iss",
        "aud",
        "azp",
        "runtime_kind",
        "sub",
        "job_id",
        "invocation_id",
        "agent_publication_id",
        "application_publication_id",
        "request_digest",
        "iat",
        "nbf",
        "exp",
        "jti"
      ],
      "properties": {
        "iss": {"const": "enterprise-agent-worker"},
        "aud": {"const": "agent-runtime"},
        "azp": {"const": "agent-worker"},
        "runtime_kind": {"$ref": "#/$defs/RuntimeKind"},
        "sub": {"$ref": "#/$defs/Identifier"},
        "job_id": {"$ref": "#/$defs/Identifier"},
        "invocation_id": {"$ref": "#/$defs/Identifier"},
        "agent_publication_id": {"$ref": "#/$defs/Identifier"},
        "application_publication_id": {"$ref": "#/$defs/Identifier"},
        "request_digest": {"$ref": "#/$defs/Sha256Digest"},
        "iat": {"type": "integer", "minimum": 1},
        "nbf": {"type": "integer", "minimum": 1},
        "exp": {"type": "integer", "minimum": 1},
        "jti": {"$ref": "#/$defs/Identifier"}
      }
    },
    "Usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "cache_read_input_tokens": {"type": "integer", "minimum": 0},
        "cache_creation_input_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "RuntimeProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_kind",
        "runtime_version",
        "protocol_version",
        "sdk_version",
        "cli_version",
        "model_connection_revision_id",
        "model_connection_config_hash"
      ],
      "properties": {
        "runtime_kind": {"$ref": "#/$defs/RuntimeKind"},
        "runtime_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "protocol_version": {"const": "1.1"},
        "sdk_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "cli_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "model_connection_revision_id": {"$ref": "#/$defs/Identifier"},
        "model_connection_config_hash": {"$ref": "#/$defs/Sha256Digest"}
      }
    },
    "RuntimeFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "retry_class", "safe_message"],
      "properties": {
        "code": {"$ref": "#/$defs/Identifier"},
        "retry_class": {"enum": ["NEVER", "TRANSIENT", "CONFIGURATION"]},
        "safe_message": {"$ref": "#/$defs/SafeMessage"}
      }
    },
    "ToolEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_call_id",
        "tool_origin",
        "server_code",
        "mcp_call_id",
        "persisted_tool_call_id",
        "tool_name",
        "status",
        "request_summary",
        "response_summary",
        "duration_ms"
      ],
      "properties": {
        "tool_call_id": {"$ref": "#/$defs/Identifier"},
        "tool_origin": {"enum": ["mcp", "sdk_builtin", "sdk_custom", "unknown"]},
        "server_code": {
          "oneOf": [
            {"$ref": "#/$defs/Identifier"},
            {"type": "null"}
          ]
        },
        "mcp_call_id": {
          "oneOf": [
            {"$ref": "#/$defs/Identifier"},
            {"type": "null"}
          ]
        },
        "persisted_tool_call_id": {
          "oneOf": [
            {"$ref": "#/$defs/Identifier"},
            {"type": "null"}
          ]
        },
        "tool_name": {"$ref": "#/$defs/Identifier"},
        "status": {"enum": ["STARTED", "SUCCEEDED", "FAILED", "DENIED"]},
        "request_summary": {"$ref": "#/$defs/JsonSummary"},
        "response_summary": {"$ref": "#/$defs/JsonSummary"},
        "duration_ms": {"type": "integer", "minimum": 0, "maximum": 1800000},
        "failure": {"$ref": "#/$defs/RuntimeFailure"}
      },
      "allOf": [
        {
          "if": {"properties": {"tool_origin": {"const": "mcp"}}},
          "then": {
            "properties": {
              "server_code": {"$ref": "#/$defs/Identifier"}
            }
          },
          "else": {
            "properties": {
              "server_code": {"const": null},
              "mcp_call_id": {"const": null},
              "persisted_tool_call_id": {"const": null}
            }
          }
        }
      ]
    },
    "TerminalResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "invocation_id",
        "request_digest",
        "last_sequence",
        "status",
        "usage",
        "runtime_provenance"
      ],
      "properties": {
        "protocol_version": {"const": "1.1"},
        "invocation_id": {"$ref": "#/$defs/Identifier"},
        "request_digest": {"$ref": "#/$defs/Sha256Digest"},
        "last_sequence": {"type": "integer", "minimum": 1, "maximum": 2048},
        "status": {"enum": ["SUCCEEDED", "FAILED", "CANCELLED"]},
        "final_answer": {"type": "string", "maxLength": 524288},
        "failure": {"$ref": "#/$defs/RuntimeFailure"},
        "usage": {"$ref": "#/$defs/Usage"},
        "runtime_provenance": {"$ref": "#/$defs/RuntimeProvenance"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "SUCCEEDED"}}},
          "then": {
            "required": ["final_answer"],
            "properties": {"final_answer": {"type": "string"}},
            "not": {
              "required": ["failure"],
              "properties": {"failure": {}}
            }
          }
        },
        {
          "if": {"properties": {"status": {"enum": ["FAILED", "CANCELLED"]}}},
          "then": {
            "required": ["failure"],
            "properties": {"failure": {"$ref": "#/$defs/RuntimeFailure"}}
          }
        }
      ]
    },
    "CancelRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "invocation_id", "request_digest", "reason"],
      "properties": {
        "protocol_version": {"const": "1.1"},
        "invocation_id": {"$ref": "#/$defs/Identifier"},
        "request_digest": {"$ref": "#/$defs/Sha256Digest"},
        "reason": {"enum": ["JOB_CANCELLED", "WORKER_TIMEOUT", "CLIENT_DISCONNECTED", "WORKER_SHUTDOWN"]}
      }
    },
    "RuntimeEvent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol_version", "invocation_id", "request_digest", "sequence", "event_type", "timestamp", "payload"],
          "properties": {
            "protocol_version": {"const": "1.1"},
            "invocation_id": {"$ref": "#/$defs/Identifier"},
            "request_digest": {"$ref": "#/$defs/Sha256Digest"},
            "sequence": {"type": "integer", "minimum": 1, "maximum": 2048},
            "event_type": {"const": "execution_started"},
            "timestamp": {"type": "string", "format": "date-time"},
            "payload": {"$ref": "#/$defs/RuntimeProvenance"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol_version", "invocation_id", "request_digest", "sequence", "event_type", "timestamp", "payload"],
          "properties": {
            "protocol_version": {"const": "1.1"},
            "invocation_id": {"$ref": "#/$defs/Identifier"},
            "request_digest": {"$ref": "#/$defs/Sha256Digest"},
            "sequence": {"type": "integer", "minimum": 1, "maximum": 2048},
            "event_type": {"const": "tool_event"},
            "timestamp": {"type": "string", "format": "date-time"},
            "payload": {"$ref": "#/$defs/ToolEvent"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol_version", "invocation_id", "request_digest", "sequence", "event_type", "timestamp", "payload"],
          "properties": {
            "protocol_version": {"const": "1.1"},
            "invocation_id": {"$ref": "#/$defs/Identifier"},
            "request_digest": {"$ref": "#/$defs/Sha256Digest"},
            "sequence": {"type": "integer", "minimum": 1, "maximum": 2048},
            "event_type": {"const": "assistant_text"},
            "timestamp": {"type": "string", "format": "date-time"},
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text"],
              "properties": {"text": {"type": "string", "maxLength": 32768}}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol_version", "invocation_id", "request_digest", "sequence", "event_type", "timestamp", "payload"],
          "properties": {
            "protocol_version": {"const": "1.1"},
            "invocation_id": {"$ref": "#/$defs/Identifier"},
            "request_digest": {"$ref": "#/$defs/Sha256Digest"},
            "sequence": {"type": "integer", "minimum": 1, "maximum": 2048},
            "event_type": {"const": "terminal"},
            "timestamp": {"type": "string", "format": "date-time"},
            "payload": {"$ref": "#/$defs/TerminalResult"}
          }
        }
      ]
    }
  }
}
