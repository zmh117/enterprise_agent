{
  "manifest_version": 3,
  "key": "",
  "name": "浏览器采集助手",
  "description": "采集所选标签及其后续子标签的操作和请求，在本地查看、标记和导出记录。",
  "version": "0.2.10",
  "minimum_chrome_version": "125",
  "incognito": "not_allowed",
  "permissions": ["identity", "alarms", "tabs", "webNavigation", "scripting", "debugger", "storage", "downloads"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "web_accessible_resources": [{ "resources": ["floating.html"], "matches": ["http://*/*", "https://*/*"] }],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "打开浏览器采集助手" },
  "options_page": "control.html",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
